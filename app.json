{
  "expo": {
    "name": "vitalis",
    "slug": "vitalis",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A0A",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Vitalis uses speech recognition to transcribe your voice input to Vitalis AI.",
        "NSMicrophoneUsageDescription": "Vitalis uses your microphone for voice input to Vitalis AI."
      }
    },
    "android": {
      "package": "com.vitalis.app",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#FFFFFF",
          "sounds": [
            "./assets/alarm.wav",
            "./assets/chime.wav"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0A0A0A"
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Vitalis uses your photo library to attach receipt images to transactions.",
          "cameraPermission": "Vitalis uses your camera to photograph receipts for transactions."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Vitalis uses Face ID to unlock the Finance module."
        }
      ],
      "expo-audio",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Vitalis uses your microphone for voice input to Vitalis AI.",
          "speechRecognitionPermission": "Vitalis uses speech recognition to transcribe your voice input to Vitalis AI."
        }
      ],
      "expo-task-manager"
    ],
    "extra": {
      "eas": {
        "projectId": "0d0ca4aa-9ae1-427e-8704-dcfdb803065d"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/0d0ca4aa-9ae1-427e-8704-dcfdb803065d"
    }
  }
}
