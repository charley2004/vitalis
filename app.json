{
  "expo": {
    "name": "vitalis",
    "slug": "vitalis",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A0A",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.vitalis.app",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#FFFFFF",
          "sounds": [
            "./assets/alarm.wav",
            "./assets/chime.wav"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0A0A0A"
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Vitalis uses your photo library to attach receipt images to transactions.",
          "cameraPermission": "Vitalis uses your camera to photograph receipts for transactions."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Vitalis uses Face ID to unlock the Finance module."
        }
      ],
      "expo-audio"
    ],
    "extra": {
      "eas": {
        "projectId": "0d0ca4aa-9ae1-427e-8704-dcfdb803065d"
      }
    }
  }
}
