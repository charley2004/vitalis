# Copy this file to .env and fill in your Supabase project's values
# (Project Settings → API in the Supabase dashboard).
# EXPO_PUBLIC_ vars are safe to ship in the client bundle — the anon key
# is designed to be public and is constrained by Row Level Security.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
